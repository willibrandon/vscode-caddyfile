{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Caddyfile Test",
  "scopeName": "source.caddyfile.test",
  "patterns": [
    {
      "begin": "\\A",
      "end": "^(?=----------\\s*$)",
      "contentName": "meta.embedded.caddyfile.caddyfile-test",
      "patterns": [{ "include": "source.caddyfile" }]
    },
    {
      "begin": "^----------\\s*$",
      "beginCaptures": {
        "0": { "name": "comment.line.separator.caddyfile-test" }
      },
      "end": "\\z",
      "contentName": "meta.embedded.json.caddyfile-test",
      "patterns": [{ "include": "source.json" }]
    }
  ]
}
