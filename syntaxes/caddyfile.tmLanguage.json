{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Caddyfile",
  "scopeName": "source.caddyfile",
  "patterns": [
    { "include": "#globalOptionsBlock" },
    { "include": "#common" }
  ],
  "repository": {
    "common": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#heredoc" },
        { "include": "#escapedQuote" },
        { "include": "#doubleQuoted" },
        { "include": "#backtickQuoted" },
        { "include": "#environment" },
        { "include": "#placeholder" },
        { "include": "#namedRoute" },
        { "include": "#snippet" },
        { "include": "#matcherDefinition" },
        { "include": "#namedMatcher" },
        { "include": "#directives" },
        { "include": "#subdirectives" },
        { "include": "#siteAddress" },
        { "include": "#headerOperator" },
        { "include": "#braces" },
        { "include": "#ipAddresses" },
        { "include": "#numbers" },
        { "include": "#constants" }
      ]
    },
    "globalOptionsBlock": {
      "begin": "^\\s*(\\{)(?:\\s*(#.*))?$",
      "beginCaptures": {
        "1": { "name": "punctuation.section.block.begin.caddyfile" },
        "2": { "name": "comment.line.number-sign.caddyfile" }
      },
      "end": "^\\s*(\\})(?:\\s*(#.*))?$",
      "endCaptures": {
        "1": { "name": "punctuation.section.block.end.caddyfile" },
        "2": { "name": "comment.line.number-sign.caddyfile" }
      },
      "name": "meta.block.global-options.caddyfile",
      "patterns": [
        { "include": "#globalOptionLine" },
        { "include": "#nestedGlobalBlock" },
        { "include": "#common" }
      ]
    },
    "nestedGlobalBlock": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.block.begin.caddyfile" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.caddyfile" }
      },
      "patterns": [
        { "include": "#globalOptionLine" },
        { "include": "#nestedGlobalBlock" },
        { "include": "#common" }
      ]
    },
    "globalOptionLine": {
      "patterns": [
        {
          "match": "^\\s*(acme_ca|acme_ca_root|acme_dns|acme_eab|admin|auto_https|cert_issuer|cert_lifetime|debug|default_bind|default_sni|dns|ech|email|events|fallback_sni|filesystem|grace_period|http_port|https_port|key_type|local_certs|log|metrics|ocsp_interval|ocsp_stapling|on_demand_tls|order|persist_config|pki|preferred_chains|renew_interval|renewal_window_ratio|servers|shutdown_delay|skip_install_trust|storage|storage_check|storage_clean_interval|tls_resolvers)(?=\\s|$)",
          "captures": {
            "1": { "name": "support.type.property-name.global-option.caddyfile" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.caddyfile",
          "match": "(^|(?<=\\s))#.*$"
        }
      ]
    },
    "heredoc": {
      "patterns": [
        {
          "name": "string.unquoted.heredoc.caddyfile",
          "begin": "(?:^|(?<=\\s))(<<)([A-Za-z0-9_-]+)[ \\t]*$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.caddyfile" },
            "2": { "name": "entity.name.tag.heredoc.caddyfile" }
          },
          "end": "^\\s*\\2\\s*$",
          "endCaptures": {
            "0": { "name": "entity.name.tag.heredoc.caddyfile" }
          },
          "patterns": [
            { "include": "#environment" },
            { "include": "#placeholder" }
          ]
        }
      ]
    },
    "escapedQuote": {
      "patterns": [
        {
          "name": "constant.character.escape.caddyfile",
          "match": "\\\\\""
        }
      ]
    },
    "doubleQuoted": {
      "patterns": [
        {
          "name": "string.quoted.double.caddyfile",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.caddyfile" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.caddyfile" }
          },
          "patterns": [
            { "name": "constant.character.escape.caddyfile", "match": "\\\\." },
            { "include": "#environment" },
            { "include": "#placeholder" }
          ]
        }
      ]
    },
    "backtickQuoted": {
      "patterns": [
        {
          "name": "string.quoted.other.backtick.caddyfile",
          "begin": "`",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.caddyfile" }
          },
          "end": "`",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.caddyfile" }
          },
          "patterns": [
            { "include": "#environment" },
            { "include": "#placeholder" }
          ]
        }
      ]
    },
    "environment": {
      "patterns": [
        {
          "name": "variable.other.environment.caddyfile",
          "match": "\\{\\$[A-Za-z_][A-Za-z0-9_]*(?::[^}]*)?\\}"
        }
      ]
    },
    "placeholder": {
      "patterns": [
        {
          "name": "variable.other.placeholder.caddyfile",
          "match": "\\{(?:[A-Za-z0-9_.-]+|args(?:\\[[^]\\r\\n]+\\])?|block(?:\\[[^]\\r\\n]+\\])?)\\}"
        }
      ]
    },
    "namedRoute": {
      "patterns": [
        {
          "name": "entity.name.function.route.caddyfile",
          "match": "^\\s*(&\\([A-Za-z0-9_.-]+\\))(?=\\s*\\{)"
        }
      ]
    },
    "snippet": {
      "patterns": [
        {
          "name": "entity.name.function.snippet.caddyfile",
          "match": "^\\s*(\\([A-Za-z0-9_.-]+\\))(?=\\s*\\{)"
        }
      ]
    },
    "matcherDefinition": {
      "patterns": [
        {
          "match": "^\\s*(@[A-Za-z0-9_-]+)\\s+([A-Za-z_][A-Za-z0-9_-]*)",
          "captures": {
            "1": { "name": "entity.name.tag.matcher.caddyfile" },
            "2": { "name": "keyword.control.matcher.caddyfile" }
          }
        }
      ]
    },
    "namedMatcher": {
      "patterns": [
        {
          "name": "variable.other.matcher.caddyfile",
          "match": "(?<!\\S)@[A-Za-z0-9_-]+"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "^\\s*(abort|acme_server|basic_auth|basicauth|bind|copy_response|copy_response_headers|encode|error|file_server|forward_auth|fs|handle|handle_errors|handle_path|header|import|intercept|invoke|log|log_append|log_name|log_skip|map|method|metrics|php_fastcgi|push|redir|request_body|request_header|respond|reverse_proxy|rewrite|root|route|skip_log|templates|timeouts|tls|tracing|try_files|uri|vars)(?=\\s|$)",
          "captures": {
            "1": { "name": "keyword.control.directive.caddyfile" }
          }
        }
      ]
    },
    "subdirectives": {
      "patterns": [
        {
          "match": "^\\s*(allow_wildcard_names|alpn|any_common_name|ask|between|body|browse|ca|ca_root|capture_stderr|challenges|ciphers|client_auth|client_ip_headers|close|compression|copy_headers|curves|dial_timeout|disable_canonical_uris|dns|dns_challenge_override_domain|dns_ttl|dynamic|eab|enable_full_duplex|enforce_origin|env|exclude|expect_continue_timeout|fail_duration|file_limit|flush_interval|force_automate|format|fs|get_certificate|gzip|handle_response|header_down|header_up|health_body|health_fails|health_follow_redirects|health_interval|health_method|health_passes|health_port|health_request_body|health_status|health_timeout|health_upstream|health_uri|hide|hostnames|include|index|insecure_secrets_log|issuer|keepalive|keepalive_count|keepalive_idle|keepalive_idle_conns|keepalive_idle_conns_per_host|keepalive_interval|key_id|lb_policy|lb_retries|lb_retry_match|lb_try_duration|lb_try_interval|level|lifetime|listener_wrappers|load|log_credentials|mac_key|match|max_conns_per_host|max_fails|max_header_size|max_size|max_write_chunk|method|mime|minimum_length|mode|name|no_hostname|observe_catchall_hosts|on_demand|origins|otlp|output|pass_thru|per_host|permission|precompressed|propagation_delay|propagation_timeout|protocols|proxy_protocol|read_buffer|read_timeout|renewal_window_ratio|replace_status|request_buffers|resolve_root_symlink|resolvers|response_buffers|response_header_timeout|reuse_private_keys|reveal_symlinks|rewrite|root|root_common_name|sampling|set|sort|span|split|status|stream_close_delay|stream_timeout|strict_sni_host|timeouts|tls|tls_client_auth|tls_insecure_skip_verify|tls_server_name|tls_trusted_ca_certs|to|trace|transport|trust_pool|trusted_proxies|trusted_proxies_strict|try_files|unhealthy_latency|unhealthy_request_count|unhealthy_status|uri|versions|write_buffer|write_timeout|zstd)(?=\\s|$)",
          "captures": {
            "1": { "name": "keyword.control.subdirective.caddyfile" }
          }
        }
      ]
    },
    "siteAddress": {
      "patterns": [
        {
          "begin": "^\\s*(?=[^#\\r\\n]+\\s+\\{\\s*(?:#.*)?$)",
          "end": "(?=\\s*\\{\\s*(?:#.*)?$)",
          "contentName": "entity.name.namespace.site-address.caddyfile",
          "patterns": [
            { "include": "#environment" },
            { "include": "#placeholder" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "headerOperator": {
      "patterns": [
        {
          "name": "keyword.operator.header.caddyfile",
          "match": "(?<!\\S)[+?\\->][A-Za-z0-9-]+"
        }
      ]
    },
    "braces": {
      "patterns": [
        {
          "name": "punctuation.section.block.caddyfile",
          "match": "[{}]"
        }
      ]
    },
    "ipAddresses": {
      "patterns": [
        {
          "name": "constant.numeric.ipv4.caddyfile",
          "match": "(?<![A-Za-z0-9_.-])(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?![A-Za-z0-9_.-])"
        },
        {
          "name": "constant.numeric.ipv6.caddyfile",
          "match": "\\[[0-9A-Fa-f:.%]+\\]|(?<![A-Za-z0-9_.-])(?:[0-9A-Fa-f]{0,4}:){2,7}[0-9A-Fa-f]{0,4}(?:%[A-Za-z0-9_.-]+)?(?![A-Za-z0-9_.-])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.caddyfile",
          "match": "(?<![A-Za-z0-9_.-])-?\\d+(?:\\.\\d+)?(?:ns|us|µs|ms|s|m|h|d)?(?![A-Za-z0-9_.-])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.caddyfile",
          "match": "(?<!\\S)(?:true|false|on|off|null)(?!\\S)"
        }
      ]
    }
  }
}
