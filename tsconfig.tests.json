{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.cache/tests.tsbuildinfo",
    "types": ["node", "vitest/globals"]
  },
  "include": ["packages/*/test/**/*.ts", "test/**/*.ts", "vitest.config.mts"],
  "references": [
    { "path": "./packages/language-core" },
    { "path": "./packages/language-server" },
    { "path": "./packages/vscode-client" }
  ]
}
